{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "nextjs", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@expense/web",
              "@expense/web/*",
              "@expense/api",
              "@expense/api/*",
              "**/apps/**",
              "**/web/src/**",
              "**/api/src/**"
            ],
            "message": "Nothing imports from an app (ADR 0014). Shared code belongs in packages/*; API types come from @expense/contract."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["**/dist/**", "**/.next/**", "**/next-env.d.ts"],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@expense/web",
                  "@expense/web/*",
                  "@expense/api",
                  "@expense/api/*",
                  "**/apps/**",
                  "**/web/src/**",
                  "**/api/src/**"
                ],
                "message": "Nothing imports from an app (ADR 0014). Shared code belongs in packages/*; API types come from @expense/contract."
              },
              {
                "group": ["@expense/db", "@expense/db/*", "**/packages/db/**"],
                "message": "apps/web never touches the database: call apps/api from the server (ADR 0013, 0014)."
              },
              {
                "group": ["@expense/test-db", "@expense/test-db/*", "**/packages/test-db/**"],
                "message": "apps/web never touches the database, not even in tests: test procedures in apps/api."
              },
              {
                "group": ["@orpc/client", "@orpc/client/*"],
                "message": "Only src/lib/api creates the oRPC client, server-side (ADR 0014): use getApi() in a server component or runAction() in a server action."
              },
              {
                "group": ["@supabase/ssr", "@supabase/supabase-js"],
                "message": "Only src/lib/supabase creates Supabase clients; auth runs in server actions (ADR 0030).",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    // The two folders allowed to create the API and Supabase clients.
    {
      "files": ["apps/web/src/lib/api/**", "apps/web/src/lib/supabase/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@expense/web",
                  "@expense/web/*",
                  "@expense/api",
                  "@expense/api/*",
                  "**/apps/**",
                  "**/web/src/**",
                  "**/api/src/**"
                ],
                "message": "Nothing imports from an app (ADR 0014). Shared code belongs in packages/*; API types come from @expense/contract."
              },
              {
                "group": ["@expense/db", "@expense/db/*", "**/packages/db/**"],
                "message": "apps/web never touches the database: call apps/api from the server (ADR 0013, 0014)."
              },
              {
                "group": ["@expense/test-db", "@expense/test-db/*", "**/packages/test-db/**"],
                "message": "apps/web never touches the database, not even in tests: test procedures in apps/api."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/contract/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@expense/web",
                  "@expense/web/*",
                  "@expense/api",
                  "@expense/api/*",
                  "**/apps/**",
                  "**/web/src/**",
                  "**/api/src/**"
                ],
                "message": "Nothing imports from an app (ADR 0014). Shared code belongs in packages/*; API types come from @expense/contract."
              },
              {
                "group": ["@expense/db", "@expense/db/*", "**/packages/db/**"],
                "message": "The contract ships to apps/web, so it may only `import type` from @expense/db.",
                "allowTypeImports": true
              },
              {
                "group": ["@expense/test-db", "@expense/test-db/*", "**/packages/test-db/**"],
                "message": "Contracts are pure; DB tests live next to the code that queries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@expense/web",
                  "@expense/web/*",
                  "@expense/api",
                  "@expense/api/*",
                  "**/apps/**",
                  "**/web/src/**",
                  "**/api/src/**"
                ],
                "message": "Nothing imports from an app (ADR 0014). Shared code belongs in packages/*; API types come from @expense/contract."
              },
              {
                "group": ["@expense/db", "@expense/db/*", "**/packages/db/**"],
                "message": "UI components are presentational: no data access."
              },
              {
                "group": ["@expense/test-db", "@expense/test-db/*", "**/packages/test-db/**"],
                "message": "UI components are presentational: no data access."
              }
            ]
          }
        ]
      }
    },
    // shadcn-generated files stay unedited so `shadcn add --overwrite` can
    // refresh them; each override turns off only the rules that file trips.
    {
      "files": ["packages/ui/src/components/label.tsx"],
      "rules": { "jsx-a11y/label-has-associated-control": "off" }
    },
    {
      "files": [
        "packages/ui/src/components/field.tsx",
        "packages/ui/src/components/input-group.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/chart.tsx"],
      "rules": { "typescript/restrict-template-expressions": "off" }
    },
    {
      "files": ["packages/ui/src/hooks/use-mobile.ts"],
      "rules": { "react/set-state-in-effect": "off" }
    }
  ]
}
