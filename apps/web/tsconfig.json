{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    // As in packages/ui, whose source this app compiles: shadcn's calendar.tsx needs it off.
    "noPropertyAccessFromIndexSignature": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src", "e2e", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
