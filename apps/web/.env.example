# Copy to .env.local for `pnpm --filter @expense/web dev`. Values match
# `pnpm db:start` (supabase/config.toml) and apps/api on port 8787.
API_URL=http://127.0.0.1:8787
SUPABASE_URL=http://127.0.0.1:56321
# The local default publishable key printed by `supabase status`.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Public origin of this app: magic-link and OAuth redirects come back here.
SITE_URL=http://localhost:3000
# Shows the Google button. Enable the provider in supabase/config.toml first.
AUTH_GOOGLE_ENABLED=false
