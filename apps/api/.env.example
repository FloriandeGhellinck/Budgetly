# Copy to .env for `pnpm --filter @expense/api dev`. Values below match `supabase start`.
# Logs in as app_runtime (no BYPASSRLS); set its password once with
# `alter role app_runtime password '...'` as postgres.
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:54322/postgres
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
PORT=8787
