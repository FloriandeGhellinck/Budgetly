# Copy to .env for `pnpm --filter @expense/api dev`. Values below match
# `pnpm db:start` (supabase/config.toml, ports 563xx). app_runtime's local
# password is set by supabase/seed.sql; production sets its own out of band.
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:56322/postgres
SUPABASE_JWKS_URL=http://127.0.0.1:56321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:56321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
PORT=8787
